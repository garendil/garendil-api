# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...   # NUNCA commitear el valor real — usar secrets en Hetzner

# Supabase Transaction Pooler (puerto 6543) — usar este, NO el puerto 5432 directo
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Neo4j (Hetzner VPS) ───────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://garendil.pe
SENTRY_DSN=

# ── Opcional: Hetzner/deploy ──────────────────────────────────────────────────
# ENVIRONMENT=production
